# Postgres (consumed by docker-compose.yml)
POSTGRES_USER=foodbridge
POSTGRES_PASSWORD=foodbridge
POSTGRES_DB=foodbridge

# MinIO (consumed by docker-compose.yml). Password must be at least 8 characters.
MINIO_ROOT_USER=foodbridge
MINIO_ROOT_PASSWORD=foodbridge123

# apps/api
DATABASE_URL=postgres://foodbridge:foodbridge@localhost:5432/foodbridge
PORT=3001
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3001
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# Object storage for listing images. S3-compatible, so production swaps these
# for real S3 credentials without a code change.
#
# S3_ENDPOINT must be the host the BROWSER can reach: SigV4 signs the Host
# header, and the browser PUTs to the presigned URL directly. The API runs on
# the host machine, so localhost works for both signing and its own calls. If
# the API is ever containerised, split this into an internal endpoint
# (http://minio:9000) and a separate public one used only for presigning.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=foodbridge-listings
S3_ACCESS_KEY=foodbridge
S3_SECRET_KEY=foodbridge123
S3_MAX_UPLOAD_BYTES=5242880
S3_SIGNED_GET_TTL=3600
